<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Pestaña SRI en la vista de Configuración de Compañía
             ============================================================ -->
        <record id="view_company_form_sri" model="ir.ui.view">
            <field name="name">res.company.form.sri</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="SRI - Facturación Electrónica" name="sri_config">
                        <group>
                            <group string="Identificación Tributaria">
                                <field name="vat" string="RUC (13 dígitos)"
                                       placeholder="Ej: 1792123456001"
                                       required="1"/>
                            </group>
                            <group string="Ambiente y Emisión">
                                <field name="sri_ambiente" readonly="1"
                                       help="Forzado a PRUEBAS en esta versión"/>
                                <field name="sri_tipo_emision" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Establecimiento">
                                <field name="sri_establecimiento"/>
                                <field name="sri_punto_emision"/>
                                <field name="sri_secuencial" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Certificado de Firma Electrónica">
                                <field name="sri_certificado_p12"
                                       filename="sri_certificado_filename"/>
                                <field name="sri_certificado_filename" invisible="1"/>
                                <field name="sri_certificado_password" password="True"/>
                            </group>
                            <group string="Datos Tributarios">
                                <field name="sri_razon_social"
                                       placeholder="Si está vacío se usa el nombre de la compañía"/>
                                <field name="sri_nombre_comercial"/>
                                <field name="sri_obligado_contabilidad"/>
                                <field name="sri_contribuyente_especial"
                                       placeholder="Solo si aplica"/>
                            </group>
                        </group>
                        <group>
                            <group string="Direcciones SRI">
                                <field name="sri_direccion_matriz"
                                       placeholder="Dirección de la matriz"/>
                                <field name="sri_direccion_establecimiento"
                                       placeholder="Dirección del punto de emisión"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
