<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             CATÁLOGO: Formas de Pago SRI
             (Referencia para el campo selection en facturacion_inherit.py)
             ============================================================ -->

        <!--
            Las formas de pago están definidas como Selection en el modelo.
            Este archivo sirve como referencia documental del catálogo oficial:

            01 - Sin utilización del sistema financiero
            15 - Compensación de deudas
            16 - Tarjeta de débito
            17 - Dinero electrónico
            18 - Tarjeta prepago
            19 - Tarjeta de crédito
            20 - Otros con utilización del sistema financiero
            21 - Endoso de títulos
        -->

        <!-- ============================================================
             CATÁLOGO: Tipos de Identificación SRI
             ============================================================ -->

        <!--
            Los tipos de identificación están definidos como Selection:

            04 - RUC
            05 - Cédula
            06 - Pasaporte
            07 - Consumidor Final
            08 - Identificación del Exterior
        -->

        <!-- ============================================================
             DATOS INICIALES: Impuesto IVA 15% (si no existe)
             ============================================================ -->

        <!-- IVA 15% para ventas (Ecuador 2024+) -->
        <record id="tax_iva_15_venta" model="account.tax" forcecreate="0">
            <field name="name">IVA 15%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="description">IVA 15%</field>
        </record>

        <!-- IVA 0% para ventas -->
        <record id="tax_iva_0_venta" model="account.tax" forcecreate="0">
            <field name="name">IVA 0%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">0.0</field>
            <field name="description">IVA 0%</field>
        </record>

    </data>
</odoo>
