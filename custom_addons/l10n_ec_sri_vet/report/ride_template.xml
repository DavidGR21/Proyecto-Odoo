<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="ride_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">

                            <!-- ═══════════════════════════════════════════
                                 ENCABEZADO: DATOS DEL EMISOR + DATOS FISCALES
                                 ═══════════════════════════════════════════ -->
                            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">

                                <!-- Columna Izquierda: Datos del Emisor -->
                                <div style="width: 48%; border: 1px solid #333; padding: 10px;">
                                    <div style="text-align: center; margin-bottom: 8px;">
                                        <img t-if="doc.facturacion_id.propietario_id.company_id.logo"
                                             t-att-src="image_data_uri(doc.facturacion_id.propietario_id.company_id.logo)"
                                             style="max-height: 60px;" alt="Logo"/>
                                    </div>
                                    <p style="text-align: center; font-size: 13px; font-weight: bold; margin: 3px 0;">
                                        <t t-esc="doc.env.company.sri_razon_social or doc.env.company.name"/>
                                    </p>
                                    <t t-if="doc.env.company.sri_nombre_comercial">
                                        <p style="text-align: center; font-size: 11px; margin: 2px 0;">
                                            <strong>Nombre Comercial:</strong>
                                            <t t-esc="doc.env.company.sri_nombre_comercial"/>
                                        </p>
                                    </t>
                                    <p style="text-align: center; font-size: 10px; margin: 2px 0;">
                                        <strong>Dirección Matriz:</strong>
                                        <t t-esc="doc.env.company.sri_direccion_matriz or doc.env.company.street or 'S/N'"/>
                                    </p>
                                    <t t-if="doc.env.company.sri_direccion_establecimiento">
                                        <p style="text-align: center; font-size: 10px; margin: 2px 0;">
                                            <strong>Dirección Sucursal:</strong>
                                            <t t-esc="doc.env.company.sri_direccion_establecimiento"/>
                                        </p>
                                    </t>
                                    <p style="text-align: center; font-size: 10px; margin: 2px 0;">
                                        <strong>Obligado a llevar Contabilidad:</strong>
                                        <t t-if="doc.env.company.sri_obligado_contabilidad">SI</t>
                                        <t t-else="">NO</t>
                                    </p>
                                    <t t-if="doc.env.company.sri_contribuyente_especial">
                                        <p style="text-align: center; font-size: 10px; margin: 2px 0;">
                                            <strong>Contribuyente Especial Nro.:</strong>
                                            <t t-esc="doc.env.company.sri_contribuyente_especial"/>
                                        </p>
                                    </t>
                                </div>

                                <!-- Columna Derecha: Datos Fiscales -->
                                <div style="width: 48%; border: 1px solid #333; padding: 10px;">
                                    <p style="font-size: 12px; font-weight: bold; margin: 3px 0;">
                                        R.U.C.: <t t-esc="doc.env.company.vat"/>
                                    </p>
                                    <p style="font-size: 14px; font-weight: bold; color: #333; margin: 8px 0;">
                                        F A C T U R A
                                    </p>
                                    <p style="font-size: 13px; font-weight: bold; margin: 3px 0;">
                                        No. <t t-esc="doc.name"/>
                                    </p>
                                    <p style="font-size: 10px; margin: 5px 0;">
                                        <strong>NÚMERO DE AUTORIZACIÓN</strong>
                                    </p>
                                    <p style="font-size: 9px; word-break: break-all; margin: 2px 0;">
                                        <t t-esc="doc.numero_autorizacion or doc.clave_acceso"/>
                                    </p>
                                    <p style="font-size: 10px; margin: 3px 0;">
                                        <strong>FECHA Y HORA DE AUTORIZACIÓN:</strong><br/>
                                        <t t-if="doc.fecha_autorizacion">
                                            <t t-esc="doc.fecha_autorizacion" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                                        </t>
                                    </p>
                                    <p style="font-size: 10px; margin: 3px 0;">
                                        <strong>AMBIENTE:</strong>
                                        <t t-if="doc.ambiente == '1'">PRUEBAS</t>
                                        <t t-else="">PRODUCCIÓN</t>
                                    </p>
                                    <p style="font-size: 10px; margin: 3px 0;">
                                        <strong>EMISIÓN:</strong> NORMAL
                                    </p>

                                    <!-- Clave de Acceso como texto -->
                                    <p style="font-size: 10px; margin: 5px 0;">
                                        <strong>CLAVE DE ACCESO</strong>
                                    </p>
                                    <p style="font-size: 8px; word-break: break-all; font-family: monospace; margin: 2px 0;">
                                        <t t-esc="doc.clave_acceso"/>
                                    </p>

                                    <!-- Código de barras Code128 generado como texto formateado -->
                                    <div style="text-align: center; margin-top: 5px;">
                                        <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=350&amp;height=45&amp;humanreadable=0' % doc.clave_acceso"
                                             style="width: 100%; max-height: 50px;"
                                             alt="Código de Barras"/>
                                    </div>
                                </div>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 DATOS DEL COMPRADOR
                                 ═══════════════════════════════════════════ -->
                            <div style="border: 1px solid #333; padding: 8px; margin-bottom: 10px;">
                                <table style="width: 100%; font-size: 10px;">
                                    <tr>
                                        <td style="width: 50%;">
                                            <strong>Razón Social / Nombres:</strong>
                                            <t t-esc="doc.facturacion_id.propietario_id.name"/>
                                        </td>
                                        <td>
                                            <strong>RUC / CI:</strong>
                                            <t t-esc="doc.facturacion_id.identificacion_cliente or doc.facturacion_id.propietario_id.vat or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Fecha Emisión:</strong>
                                            <t t-esc="doc.facturacion_id.fecha_factura" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                        </td>
                                        <td>
                                            <strong>Guía de Remisión:</strong> -
                                        </td>
                                    </tr>
                                    <t t-if="doc.facturacion_id.propietario_id.street">
                                        <tr>
                                            <td colspan="2">
                                                <strong>Dirección:</strong>
                                                <t t-esc="doc.facturacion_id.propietario_id.street"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 DETALLE DE LA FACTURA
                                 ═══════════════════════════════════════════ -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 10px;">
                                <thead>
                                    <tr style="background-color: #e0e0e0;">
                                        <th style="border: 1px solid #333; padding: 4px; text-align: center;">Cod. Principal</th>
                                        <th style="border: 1px solid #333; padding: 4px; text-align: left;">Descripción</th>
                                        <th style="border: 1px solid #333; padding: 4px; text-align: center;">Cant.</th>
                                        <th style="border: 1px solid #333; padding: 4px; text-align: right;">P. Unitario</th>
                                        <th style="border: 1px solid #333; padding: 4px; text-align: right;">Descuento</th>
                                        <th style="border: 1px solid #333; padding: 4px; text-align: right;">P. Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.facturacion_id.linea_ids" t-as="linea">
                                        <tr>
                                            <td style="border: 1px solid #999; padding: 3px; text-align: center;">
                                                <t t-if="linea.tipo_linea == 'cita'">
                                                    CITA-<t t-esc="linea.cita_id.id if linea.cita_id else 0"/>
                                                </t>
                                                <t t-elif="linea.tipo_linea == 'medicamento'">
                                                    MED-<t t-esc="linea.inventario_id.id if linea.inventario_id else 0"/>
                                                </t>
                                                <t t-elif="linea.tipo_linea == 'producto'">
                                                    PROD-<t t-esc="linea.inventario_id.id if linea.inventario_id else 0"/>
                                                </t>
                                                <t t-else="">
                                                    SRV-<t t-esc="linea.inventario_id.id if linea.inventario_id else 0"/>
                                                </t>
                                            </td>
                                            <td style="border: 1px solid #999; padding: 3px;">
                                                <t t-esc="linea.nombre_item or linea.descripcion"/>
                                            </td>
                                            <td style="border: 1px solid #999; padding: 3px; text-align: center;">
                                                <t t-esc="'%.2f' % linea.cantidad"/>
                                            </td>
                                            <td style="border: 1px solid #999; padding: 3px; text-align: right;">
                                                <t t-esc="'%.2f' % linea.precio_unitario"/>
                                            </td>
                                            <td style="border: 1px solid #999; padding: 3px; text-align: right;">
                                                0.00
                                            </td>
                                            <td style="border: 1px solid #999; padding: 3px; text-align: right;">
                                                <t t-esc="'%.2f' % linea.subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- ═══════════════════════════════════════════
                                 TOTALES Y FORMA DE PAGO
                                 ═══════════════════════════════════════════ -->
                            <div style="display: flex; justify-content: space-between;">
                                <!-- Forma de Pago -->
                                <div style="width: 48%; border: 1px solid #333; padding: 8px;">
                                    <p style="font-size: 10px; font-weight: bold; margin: 0 0 5px 0;">
                                        Forma de Pago
                                    </p>
                                    <table style="width: 100%; font-size: 10px; border-collapse: collapse;">
                                        <thead>
                                            <tr style="background-color: #e0e0e0;">
                                                <th style="border: 1px solid #999; padding: 3px;">Descripción</th>
                                                <th style="border: 1px solid #999; padding: 3px; text-align: right;">Valor</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="border: 1px solid #999; padding: 3px;">
                                                    <t t-set="forma_pago_desc" t-value="dict(doc.facturacion_id._fields['sri_forma_pago'].selection).get(doc.facturacion_id.sri_forma_pago, 'Sin utilización del sistema financiero')"/>
                                                    <t t-esc="forma_pago_desc"/>
                                                </td>
                                                <td style="border: 1px solid #999; padding: 3px; text-align: right;">
                                                    <t t-esc="'%.2f' % doc.facturacion_id.total"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Totales -->
                                <div style="width: 48%; border: 1px solid #333; padding: 8px;">
                                    <table style="width: 100%; font-size: 10px;">
                                        <tr>
                                            <td><strong>SUBTOTAL SIN IMPUESTOS</strong></td>
                                            <td style="text-align: right;">
                                                <t t-esc="'%.2f' % doc.facturacion_id.subtotal"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>SUBTOTAL 0%</strong></td>
                                            <td style="text-align: right;">
                                                <t t-if="not doc.facturacion_id.impuesto_id or doc.facturacion_id.impuesto_id.amount == 0">
                                                    <t t-esc="'%.2f' % doc.facturacion_id.subtotal"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>SUBTOTAL IVA
                                                    <t t-if="doc.facturacion_id.impuesto_id">
                                                        <t t-esc="'%.0f' % doc.facturacion_id.impuesto_id.amount"/>%
                                                    </t>
                                                </strong>
                                            </td>
                                            <td style="text-align: right;">
                                                <t t-if="doc.facturacion_id.impuesto_id and doc.facturacion_id.impuesto_id.amount > 0">
                                                    <t t-esc="'%.2f' % doc.facturacion_id.subtotal"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>DESCUENTO</strong></td>
                                            <td style="text-align: right;">0.00</td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>IVA
                                                    <t t-if="doc.facturacion_id.impuesto_id">
                                                        <t t-esc="'%.0f' % doc.facturacion_id.impuesto_id.amount"/>%
                                                    </t>
                                                </strong>
                                            </td>
                                            <td style="text-align: right;">
                                                <t t-esc="'%.2f' % doc.facturacion_id.impuesto_total"/>
                                            </td>
                                        </tr>
                                        <tr style="border-top: 2px solid #333; font-size: 12px;">
                                            <td><strong>VALOR TOTAL</strong></td>
                                            <td style="text-align: right;">
                                                <strong><t t-esc="'%.2f' % doc.facturacion_id.total"/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 INFORMACIÓN ADICIONAL
                                 ═══════════════════════════════════════════ -->
                            <t t-if="doc.facturacion_id.observaciones">
                                <div style="border: 1px solid #333; padding: 8px; margin-top: 10px;">
                                    <p style="font-size: 10px; font-weight: bold; margin: 0 0 3px 0;">
                                        Información Adicional
                                    </p>
                                    <table style="width: 100%; font-size: 10px;">
                                        <tr>
                                            <td><strong>Observaciones:</strong></td>
                                            <td><t t-esc="doc.facturacion_id.observaciones"/></td>
                                        </tr>
                                        <t t-if="doc.facturacion_id.propietario_id.email">
                                            <tr>
                                                <td><strong>Email:</strong></td>
                                                <td><t t-esc="doc.facturacion_id.propietario_id.email"/></td>
                                            </tr>
                                        </t>
                                    </table>
                                </div>
                            </t>

                            <!-- ═══════════════════════════════════════════
                                 LEYENDA OBLIGATORIA DEL SRI
                                 ═══════════════════════════════════════════ -->
                            <div style="text-align: center; margin-top: 15px; padding: 8px; border-top: 1px dashed #999;">
                                <p style="font-size: 8px; color: #666; font-style: italic;">
                                    Este documento es una representación impresa de un comprobante electrónico.
                                </p>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
