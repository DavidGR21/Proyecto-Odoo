<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Definición del reporte RIDE PDF -->
        <record id="action_report_ride" model="ir.actions.report">
            <field name="name">RIDE - Factura Electrónica</field>
            <field name="model">sri.documento.electronico</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ec_sri_vet.ride_template</field>
            <field name="report_file">l10n_ec_sri_vet.ride_template</field>
            <field name="print_report_name">'RIDE_%s' % object.clave_acceso</field>
            <field name="paperformat_id" ref="base.paperformat_us"/>
        </record>

    </data>
</odoo>
