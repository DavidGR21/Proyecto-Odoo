<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- CRON: Enviar recordatorios de cita (cada hora)               -->
        <!-- Busca citas en las próximas 24h sin recordatorio enviado     -->
        <!-- ============================================================ -->
        <record id="ir_cron_recordatorio_cita" model="ir.cron">
            <field name="name">Veterinaria: Enviar recordatorios de cita (24h antes)</field>
            <field name="model_id" ref="model_veterinaria_cita"/>
            <field name="state">code</field>
            <field name="code">model._cron_enviar_recordatorios()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
