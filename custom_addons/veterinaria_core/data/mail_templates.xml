<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================================ -->
        <!-- PLANTILLA: Confirmación de Cita                              -->
        <!-- Se envía automáticamente al crear una cita                   -->
        <!-- ============================================================ -->
        <record id="mail_template_cita_confirmacion" model="mail.template">
            <field name="name">Veterinaria: Confirmación de Cita</field>
            <field name="model_id" ref="model_veterinaria_cita"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.propietario_id.email }}</field>
            <field name="subject">🐾 Cita Confirmada - {{ object.paciente_id.name }} | VitalPet</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <div style="background-color: #2E86AB; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0;">🐾 VitalPet</h1>
        <p style="color: #E0F0FF; margin: 5px 0 0 0;">Clínica Veterinaria</p>
    </div>
    <div style="background-color: #f9f9f9; padding: 30px; border: 1px solid #ddd;">
        <h2 style="color: #2E86AB;">¡Cita Confirmada!</h2>
        <p>Estimado/a <strong><t t-out="object.propietario_id.name"/></strong>,</p>
        <p>Su cita ha sido agendada exitosamente. Aquí los detalles:</p>
        
        <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
            <tr style="background-color: #2E86AB; color: white;">
                <td style="padding: 10px; font-weight: bold;" colspan="2">Detalles de la Cita</td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; font-weight: bold; width: 40%;">📅 Fecha y Hora:</td>
                <td style="padding: 10px;"><t t-out="object.fecha_hora.strftime('%d/%m/%Y a las %H:%M') if object.fecha_hora else ''"/></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd; background-color: #f5f5f5;">
                <td style="padding: 10px; font-weight: bold;">🐕 Mascota:</td>
                <td style="padding: 10px;"><t t-out="object.paciente_id.name"/> (<t t-out="object.paciente_id.especie"/>)</td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; font-weight: bold;">👨‍⚕️ Veterinario:</td>
                <td style="padding: 10px;"><t t-out="object.veterinario_id.name"/></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd; background-color: #f5f5f5;">
                <td style="padding: 10px; font-weight: bold;">📝 Motivo:</td>
                <td style="padding: 10px;"><t t-out="object.motivo"/></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; font-weight: bold;">⏱️ Duración:</td>
                <td style="padding: 10px;"><t t-out="object.duracion"/> hora(s)</td>
            </tr>
        </table>

        <div style="background-color: #FFF3CD; border: 1px solid #FFEEBA; padding: 15px; border-radius: 5px; margin: 15px 0;">
            <strong>⚠️ Recordatorio:</strong> Por favor llegue 10 minutos antes de su cita. 
            Si necesita cancelar o reprogramar, contáctenos con al menos 24 horas de anticipación.
        </div>
    </div>
    <div style="background-color: #2E86AB; padding: 15px; text-align: center; border-radius: 0 0 8px 8px;">
        <p style="color: white; margin: 0; font-size: 12px;">© VitalPet - Clínica Veterinaria | Este es un correo automático</p>
    </div>
</div>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- PLANTILLA: Recordatorio de Cita (24h antes)                  -->
        <!-- Enviada por cron automático                                  -->
        <!-- ============================================================ -->
        <record id="mail_template_cita_recordatorio" model="mail.template">
            <field name="name">Veterinaria: Recordatorio de Cita</field>
            <field name="model_id" ref="model_veterinaria_cita"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.propietario_id.email }}</field>
            <field name="subject">⏰ Recordatorio: Cita mañana - {{ object.paciente_id.name }} | VitalPet</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <div style="background-color: #F18F01; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0;">⏰ Recordatorio de Cita</h1>
        <p style="color: #FFF3CD; margin: 5px 0 0 0;">VitalPet - Clínica Veterinaria</p>
    </div>
    <div style="background-color: #f9f9f9; padding: 30px; border: 1px solid #ddd;">
        <p>Estimado/a <strong><t t-out="object.propietario_id.name"/></strong>,</p>
        <p>Le recordamos que tiene una cita programada para <strong>mañana</strong>:</p>
        
        <div style="background-color: white; border-left: 4px solid #F18F01; padding: 15px; margin: 20px 0;">
            <p><strong>📅 Fecha:</strong> <t t-out="object.fecha_hora.strftime('%d/%m/%Y') if object.fecha_hora else ''"/></p>
            <p><strong>🕐 Hora:</strong> <t t-out="object.fecha_hora.strftime('%H:%M') if object.fecha_hora else ''"/></p>
            <p><strong>🐕 Mascota:</strong> <t t-out="object.paciente_id.name"/></p>
            <p><strong>👨‍⚕️ Veterinario:</strong> <t t-out="object.veterinario_id.name"/></p>
            <p><strong>📝 Motivo:</strong> <t t-out="object.motivo"/></p>
        </div>

        <p>Por favor llegue 10 minutos antes. ¡Los esperamos!</p>
    </div>
    <div style="background-color: #F18F01; padding: 15px; text-align: center; border-radius: 0 0 8px 8px;">
        <p style="color: white; margin: 0; font-size: 12px;">© VitalPet - Clínica Veterinaria</p>
    </div>
</div>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- PLANTILLA: Cita Completada (resumen post-consulta)           -->
        <!-- ============================================================ -->
        <record id="mail_template_cita_completada" model="mail.template">
            <field name="name">Veterinaria: Resumen de Consulta</field>
            <field name="model_id" ref="model_veterinaria_cita"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.propietario_id.email }}</field>
            <field name="subject">✅ Consulta Completada - {{ object.paciente_id.name }} | VitalPet</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <div style="background-color: #28A745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0;">✅ Consulta Completada</h1>
        <p style="color: #D4EDDA; margin: 5px 0 0 0;">VitalPet - Clínica Veterinaria</p>
    </div>
    <div style="background-color: #f9f9f9; padding: 30px; border: 1px solid #ddd;">
        <p>Estimado/a <strong><t t-out="object.propietario_id.name"/></strong>,</p>
        <p>La consulta de <strong><t t-out="object.paciente_id.name"/></strong> ha sido completada exitosamente.</p>
        
        <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
            <tr style="background-color: #28A745; color: white;">
                <td style="padding: 10px; font-weight: bold;" colspan="2">Resumen de la Consulta</td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; font-weight: bold; width: 40%;">📅 Fecha:</td>
                <td style="padding: 10px;"><t t-out="object.fecha_hora.strftime('%d/%m/%Y %H:%M') if object.fecha_hora else ''"/></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd; background-color: #f5f5f5;">
                <td style="padding: 10px; font-weight: bold;">👨‍⚕️ Atendido por:</td>
                <td style="padding: 10px;"><t t-out="object.veterinario_id.name"/></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; font-weight: bold;">📝 Motivo:</td>
                <td style="padding: 10px;"><t t-out="object.motivo"/></td>
            </tr>
            <tr t-if="object.observaciones" style="border-bottom: 1px solid #ddd; background-color: #f5f5f5;">
                <td style="padding: 10px; font-weight: bold;">📋 Observaciones:</td>
                <td style="padding: 10px;"><t t-out="object.observaciones"/></td>
            </tr>
        </table>

        <p>Gracias por confiar en VitalPet. ¡Nos vemos en la próxima consulta!</p>
    </div>
    <div style="background-color: #28A745; padding: 15px; text-align: center; border-radius: 0 0 8px 8px;">
        <p style="color: white; margin: 0; font-size: 12px;">© VitalPet - Clínica Veterinaria</p>
    </div>
</div>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- PLANTILLA: Credenciales del Portal                           -->
        <!-- Se envía al crear un nuevo propietario o asignarle acceso    -->
        <!-- ============================================================ -->
        <record id="mail_template_credenciales_portal" model="mail.template">
            <field name="name">Veterinaria: Credenciales de Acceso</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Bienvenido a VitalPet - Tus Credenciales de Acceso</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <div style="background-color: #6C5B7B; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0;">¡Bienvenido a VitalPet!</h1>
        <p style="color: #E8E8E8; margin: 5px 0 0 0;">Tu portal veterinario de confianza</p>
    </div>
    <div style="background-color: #f9f9f9; padding: 30px; border: 1px solid #ddd;">
        <p>Estimado/a <strong><t t-out="object.name"/></strong>,</p>
        <p>Hemos creado tu cuenta de acceso al portal de VitalPet. Aquí podrás ver la información de tus mascotas, su historia clínica, citas y recetas médicas.</p>
        
        <div style="background-color: white; border-left: 4px solid #6C5B7B; padding: 15px; margin: 20px 0;">
            <p style="margin: 0 0 10px 0;">A continuación, tus credenciales temporales de acceso:</p>
            <p style="margin: 5px 0;"><strong>👤 Usuario:</strong> <t t-out="object.email"/></p>
            <p style="margin: 5px 0;"><strong>🔑 Contraseña:</strong> <t t-out="ctx.get('portal_password')"/></p>
        </div>

        <p>Te recomendamos cambiar tu contraseña una vez que ingreses al portal.</p>
        
        <div style="text-align: center; margin-top: 30px;">
            <a t-att-href="object.get_base_url() + '/web/login'" style="background-color: #6C5B7B; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-weight: bold;">Acceder al Portal</a>
        </div>
    </div>
    <div style="background-color: #6C5B7B; padding: 15px; text-align: center; border-radius: 0 0 8px 8px;">
        <p style="color: white; margin: 0; font-size: 12px;">© VitalPet - Clínica Veterinaria</p>
    </div>
</div>
            </field>
        </record>
    </data>
</odoo>
