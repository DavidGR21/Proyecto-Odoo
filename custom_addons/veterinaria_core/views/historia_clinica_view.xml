<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de Formulario para Historia Clínica - DISEÑO MEJORADO -->
        <record id="view_veterinaria_historia_clinica_form" model="ir.ui.view">
            <field name="name">veterinaria.historia_clinica.form</field>
            <field name="model">veterinaria.historia_clinica</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <header>
                        <field name="activa" widget="boolean_toggle"/>
                    </header>
                    <sheet>

                        <!-- ── Cabecera: nombre paciente + fecha apertura ── -->
                        <div class="oe_title mb-3">
                            <h1 class="mb-0 text-primary">
                                <i class="fa fa-paw me-2"/>
                                <field name="paciente_id" readonly="1"/>
                            </h1>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-folder-open me-1"/> Historia Clínica &#160;|&#160;
                                <i class="fa fa-calendar me-1"/> Apertura:
                                <field name="fecha_apertura" widget="date" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <!-- ── Tarjetas de métricas rápidas ── -->
                        <div class="row mb-4">
                            <!-- Total citas -->
                            <div class="col-md-3 col-sm-6">
                                <div class="bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3 p-3 text-center h-100">
                                    <i class="fa fa-calendar-check-o fa-2x text-primary mb-2"/>
                                    <div class="fs-2 fw-bold text-primary">
                                        <field name="cita_count" readonly="1" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">Total de Citas</div>
                                </div>
                            </div>
                            <!-- Peso -->
                            <div class="col-md-3 col-sm-6">
                                <div class="bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 p-3 text-center h-100">
                                    <i class="fa fa-balance-scale fa-2x text-success mb-2"/>
                                    <div class="fs-2 fw-bold text-success">
                                        <field name="peso" readonly="0" nolabel="1" class="d-inline"/> <span class="small">kg</span>
                                    </div>
                                    <div class="small text-muted">Peso Actual</div>
                                </div>
                            </div>
                            <!-- Tipo de sangre -->
                            <div class="col-md-3 col-sm-6">
                                <div class="bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 p-3 text-center h-100">
                                    <i class="fa fa-tint fa-2x text-danger mb-2"/>
                                    <div class="fs-5 fw-bold text-danger mt-1">
                                        <field name="tipo_sangre" readonly="0" nolabel="1" widget="badge"/>
                                    </div>
                                    <div class="small text-muted">Tipo de Sangre</div>
                                </div>
                            </div>
                            <!-- Estado historia -->
                            <div class="col-md-3 col-sm-6">
                                <div class="bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3 p-3 text-center h-100">
                                    <i class="fa fa-heartbeat fa-2x text-warning mb-2"/>
                                    <div class="fs-5 fw-bold text-warning mt-1">
                                        <field name="activa" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">Historia Activa</div>
                                </div>
                            </div>
                        </div>

                        <!-- ── Sección: Información Médica ── -->
                        <div class="o_group mb-3">
                            <div class="col-12">
                                <h5 class="text-primary border-bottom border-primary border-opacity-25 pb-2 mb-3">
                                    <i class="fa fa-medkit me-2"/>Información Médica
                                </h5>
                            </div>
                        </div>

                        <group>
                            <group string="Alertas Clínicas">
                                <field name="alergias"
                                       placeholder="Ninguna alergia registrada..."
                                       widget="char"/>
                                <field name="condiciones_cronicas"
                                       placeholder="Sin condiciones crónicas conocidas..."/>
                            </group>
                            <group string="Datos Generales">
                                <field name="paciente_id" readonly="1"/>
                                <field name="fecha_apertura" readonly="1"/>
                            </group>
                        </group>

                        <!-- ── Sección: Observaciones generales ── -->
                        <group>
                            <group string="Observaciones Generales" colspan="2">
                                <field name="observaciones"
                                       placeholder="Notas clínicas generales del paciente (independientes de cada cita)..."
                                       nolabel="1"
                                       colspan="2"/>
                            </group>
                        </group>

                        <!-- ── Notebook: Historial de Citas ── -->
                        <notebook>
                            <page string="Historial de Citas" name="citas">
                                <field name="cita_ids" nolabel="1" readonly="1">
                                    <list decoration-success="estado == 'completada'"
                                          decoration-danger="estado == 'cancelada'"
                                          decoration-warning="estado == 'no_asistio'"
                                          decoration-info="estado == 'programada'"
                                          default_order="fecha_hora desc">
                                        <field name="fecha_hora" string="Fecha y Hora" optional="show"/>
                                        <field name="estado" widget="badge"
                                               decoration-success="estado == 'completada'"
                                               decoration-danger="estado == 'cancelada'"
                                               decoration-warning="estado == 'no_asistio'"
                                               decoration-info="estado == 'programada'"
                                               optional="show"/>
                                        <field name="veterinario_id" string="Veterinario" optional="show"/>
                                        <field name="propietario_id" string="Propietario" optional="show"/>
                                        <field name="motivo" string="Motivo de la Cita" optional="show"/>
                                        <field name="sintomas_resumen" string="Síntomas" optional="show"/>
                                        <field name="receta_count" string="Recetas" optional="show"/>
                                    </list>
                                    <form string="Detalle de Cita">
                                        <sheet>
                                            <!-- Cabecera de la cita -->
                                            <div class="oe_title mb-3">
                                                <h3>
                                                    <i class="fa fa-calendar-o me-2 text-primary"/>
                                                    <field name="name" readonly="1"/>
                                                </h3>
                                            </div>

                                            <!-- Estado badge prominente -->
                                            <div class="mb-3">
                                                <field name="estado" widget="statusbar"
                                                       statusbar_visible="programada,completada,cancelada,no_asistio"
                                                       readonly="1"/>
                                            </div>

                                            <group>
                                                <group string="Datos de la Cita">
                                                    <field name="fecha_hora" readonly="1"/>
                                                    <field name="veterinario_id" readonly="1"/>
                                                    <field name="servicio_id" readonly="1"/>
                                                    <field name="duracion" readonly="1"/>
                                                </group>
                                                <group string="Motivo y Síntomas">
                                                    <field name="motivo" readonly="1"/>
                                                    <field name="sintoma_ids"
                                                           widget="many2many_tags"
                                                           readonly="1"
                                                           string="Síntomas Reportados"/>
                                                </group>
                                            </group>

                                            <!-- Recetas médicas (solo si existen) -->
                                            <group string="Receta Médica / Tratamiento"
                                                   invisible="not receta_ids">
                                                <field name="receta_ids" readonly="1" nolabel="1">
                                                    <list create="false" edit="false" delete="false">
                                                        <field name="name" string="Referencia"/>
                                                        <field name="fecha_emision" string="Fecha"/>
                                                        <field name="diagnostico" string="Diagnóstico"/>
                                                        <field name="state" widget="badge"
                                                               decoration-success="state == 'finalizada'"
                                                               decoration-warning="state == 'borrador'"
                                                               string="Estado"/>
                                                    </list>
                                                    <form create="false" edit="false" delete="false">
                                                        <sheet>
                                                            <group>
                                                                <group string="Datos de Receta">
                                                                    <field name="name" string="Referencia" readonly="1"/>
                                                                    <field name="fecha_emision" string="Fecha" readonly="1"/>
                                                                    <field name="state" widget="badge" readonly="1"/>
                                                                </group>
                                                                <group string="Clínico">
                                                                    <field name="diagnostico" string="Diagnóstico" readonly="1"/>
                                                                </group>
                                                            </group>
                                                            <notebook>
                                                                <page string="Medicamentos Recetados">
                                                                    <field name="linea_ids" readonly="1">
                                                                        <list>
                                                                            <field name="tipo_origen" string="Origen"/>
                                                                            <field name="nombre_medicamento_display" string="Medicamento"/>
                                                                            <field name="dosis"/>
                                                                            <field name="frecuencia_horas" string="Cada (h)"/>
                                                                            <field name="duracion_dias" string="Días"/>
                                                                            <field name="cantidad_total" string="Total"/>
                                                                        </list>
                                                                    </field>
                                                                </page>
                                                                <page string="Indicaciones Adicionales">
                                                                    <group>
                                                                        <field name="instrucciones_generales" readonly="1"/>
                                                                        <field name="observaciones_adicionales" readonly="1"/>
                                                                    </group>
                                                                </page>
                                                            </notebook>
                                                        </sheet>
                                                    </form>
                                                </field>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Vista de Lista para Historia Clínica -->
        <record id="view_veterinaria_historia_clinica_list" model="ir.ui.view">
            <field name="name">veterinaria.historia_clinica.list</field>
            <field name="model">veterinaria.historia_clinica</field>
            <field name="arch" type="xml">
                <list create="false" edit="false" delete="false"
                      decoration-muted="not activa">
                    <field name="paciente_id"/>
                    <field name="fecha_apertura" string="Apertura"/>
                    <field name="cita_count" string="Citas" optional="show"/>
                    <field name="peso" string="Peso (kg)" optional="show"/>
                    <field name="tipo_sangre" widget="badge" optional="show"/>
                    <field name="activa" widget="boolean_favorite" string="Activa" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Vista de búsqueda para Historia Clínica -->
        <record id="view_veterinaria_historia_clinica_search" model="ir.ui.view">
            <field name="name">veterinaria.historia_clinica.search</field>
            <field name="model">veterinaria.historia_clinica</field>
            <field name="arch" type="xml">
                <search>
                    <field name="paciente_id" string="Paciente"/>
                    <filter name="activas" string="Activas" domain="[('activa', '=', True)]"/>
                    <filter name="inactivas" string="Inactivas" domain="[('activa', '=', False)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Paciente" name="group_by_paciente" context="{'group_by': 'paciente_id'}"/>
                        <filter string="Activa" name="group_by_activa" context="{'group_by': 'activa'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción para vista de Historia Clínica -->
        <record id="action_veterinaria_historia_clinica" model="ir.actions.act_window">
            <field name="name">Historia Clínica</field>
            <field name="res_model">veterinaria.historia_clinica</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'create': False, 'delete': False}</field>
        </record>
    </data>
</odoo>
