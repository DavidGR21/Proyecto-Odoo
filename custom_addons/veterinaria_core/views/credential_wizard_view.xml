<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credential_wizard_form" model="ir.ui.view">
        <field name="name">veterinaria.credential.wizard.form</field>
        <field name="model">veterinaria.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="Credenciales de acceso al portal">
                <sheet>
                    <group string="Credenciales para el cliente">
                        <field name="partner_name"/>
                        <field name="login"/>
                        <field name="password"/>
                    </group>
                    <div class="alert alert-warning mt-3" role="alert">
                        <strong>Solo para uso interno.</strong>
                        Las credenciales también se han registrado en el log del servidor
                        (busca la línea <code>[PORTAL]</code> en la consola de Odoo).
                        Entrega login y contraseña al cliente; recomiéndele cambiarla desde su perfil.
                        El cliente inicia sesión en <strong>/web/login</strong>.
                    </div>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
