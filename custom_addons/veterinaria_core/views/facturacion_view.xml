<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             VISTA FORMULARIO - Facturacion
             El encabezado ya NO tiene paciente_id.
             Las lineas usan item_ref (Reference) para un unico selector.
             ============================================================ -->
        <record id="facturacion_form_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.form</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <form string="Factura de Servicios">
                    <header>
                        <button name="action_validar_factura"
                                string="Validar Factura"
                                type="object"
                                class="oe_highlight"
                                invisible="estado != 'borrador'"/>
                        <button name="action_cancelar_factura"
                                string="Cancelar"
                                type="object"
                                invisible="estado != 'validado'"/>
                        <button name="action_importar_receta"
                                string="Importar desde Receta"
                                type="object"
                                class="btn btn-secondary"
                                invisible="estado != 'borrador'"/>
                        <field name="estado" widget="statusbar"
                               statusbar_visible="borrador,validado,cancelado"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <group>
                            <group string="Datos del Cliente">
                                <field name="fecha_factura"
                                       readonly="estado != 'borrador'"/>
                                <field name="propietario_id"
                                       readonly="estado != 'borrador'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Lineas de Facturacion">
                                <div class="alert alert-info" role="alert"
                                     invisible="estado != 'borrador'">
                                    <strong>Instrucciones:</strong>
                                    En la columna <b>Item</b> seleccione primero el tipo de registro
                                    (Cita Veterinaria o Producto/Medicamento/Servicio) y luego el
                                    registro especifico. El precio se auto-completa.
                                </div>

                                <field name="linea_ids" readonly="estado != 'borrador'">
                                    <list>
                                        <!-- Columna tipo (calculada, solo lectura) -->
                                        <field name="tipo_linea"
                                               string="Tipo"
                                               readonly="1"
                                               optional="show"/>

                                        <!-- Columna unificada: nombre -->
                                        <field name="nombre_item"
                                               string="Item"
                                               readonly="1"/>

                                        <field name="descripcion"
                                               string="Descripcion"
                                               readonly="1"/>
                                        <field name="cantidad"
                                               readonly="parent.estado != 'borrador'"/>
                                        <field name="precio_unitario"
                                               readonly="parent.estado != 'borrador'"/>
                                        <field name="impuesto_ids"
                                               widget="many2many_tags"
                                               readonly="1"
                                               force_save="1"
                                               optional="show"/>
                                        <field name="impuesto_linea"
                                               string="IVA"
                                               readonly="1"/>
                                        <field name="subtotal" readonly="1"/>
                                    </list>
                                </field>

                                <group class="oe_subtotal_footer oe_right">
                                    <field name="subtotal" readonly="1"/>
                                    <field name="detalles_impuestos_html" widget="html" nolabel="1" colspan="2"/>
                                    <field name="impuesto_total" readonly="1"/>
                                    <field name="total"
                                           class="oe_subtotal_footer_separator"
                                           readonly="1"/>
                                </group>
                            </page>

                            <page string="Observaciones">
                                <field name="observaciones"
                                       readonly="estado != 'borrador'"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- VISTA LISTA -->
        <record id="facturacion_list_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.list</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <list decoration-info="estado == 'borrador'"
                      decoration-success="estado == 'validado'"
                      decoration-danger="estado == 'cancelado'">
                    <field name="name"/>
                    <field name="fecha_factura"/>
                    <field name="propietario_id"/>
                    <field name="subtotal"/>
                    <field name="impuesto_total"/>
                    <field name="total"/>
                    <field name="estado"/>
                </list>
            </field>
        </record>

        <!-- VISTA BUSQUEDA -->
        <record id="facturacion_search_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.search</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="N° Factura"/>
                    <field name="propietario_id" string="Cliente"/>
                    <filter name="borrador" string="Borrador"
                            domain="[('estado', '=', 'borrador')]"/>
                    <filter name="validado" string="Validado"
                            domain="[('estado', '=', 'validado')]"/>
                    <filter name="cancelado" string="Cancelado"
                            domain="[('estado', '=', 'cancelado')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_estado"
                                context="{'group_by': 'estado'}"/>
                        <filter string="Cliente" name="group_cliente"
                                context="{'group_by': 'propietario_id'}"/>
                        <filter string="Fecha" name="group_fecha"
                                context="{'group_by': 'fecha_factura'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACCION -->
        <record id="facturacion_action" model="ir.actions.act_window">
            <field name="name">Facturacion por Servicios</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">veterinaria.facturacion</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva factura
                </p>
                <p>
                    Una factura puede incluir citas, productos, medicamentos y
                    servicios de distintas mascotas del mismo cliente.
                </p>
            </field>
        </record>

    </data>
</odoo>