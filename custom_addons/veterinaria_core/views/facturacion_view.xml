<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View para Facturación -->
        <record id="facturacion_form_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.form</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <form>
                    <!-- HEADER  BOTONES VALIDAR Y GENERAR -->
                    <header>
                        <button name="action_validar_factura" string="Validar y Generar Factura" 
                                type="object" class="oe_highlight" 
                                invisible="estado != 'borrador'"/>
                        
                        <button name="action_cancelar_factura" string="Cancelar" 
                                type="object" 
                                invisible="estado != 'validado'"/>
                        
                        <field name="estado" widget="statusbar" 
                               statusbar_visible="borrador,validado,cancelado"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        
                        <group>
                            <field name="fecha_factura" readonly="estado != 'borrador'"/>
                            <field name="propietario_id" readonly="estado != 'borrador'"/>
                            <field name="paciente_id" readonly="estado != 'borrador'"/>
                        </group>
                        
                        <notebook>
                            <page string="Líneas">
                                <field name="linea_ids" readonly="estado != 'borrador'">
                                    <list editable="bottom">
                                        <field name="tipo_linea" readonly="parent.estado != 'borrador'"/>
                                        <field name="cita_id" domain="[('paciente_id.propietario_id', '=', parent.propietario_id)]"
                                            readonly="parent.estado != 'borrador' or tipo_linea != 'cita'"
                                            required="tipo_linea == 'cita'"/>
                                        <field name="medicamento_id"
                                            readonly="parent.estado != 'borrador' or tipo_linea != 'medicamento'"
                                            required="tipo_linea == 'medicamento'"/>
                                        <field name="producto_id"
                                            readonly="parent.estado != 'borrador' or tipo_linea != 'producto'"
                                            required="tipo_linea == 'producto'"/>
                                        <field name="servicio_id"
                                            readonly="parent.estado != 'borrador' or tipo_linea != 'servicio'"
                                            required="tipo_linea == 'servicio'"/>
                                        <field name="cantidad" readonly="parent.estado != 'borrador'"/>
                                        <field name="precio_unitario" readonly="parent.estado != 'borrador'"/>
                                        <field name="subtotal" readonly="1"/>
                                        <field name="total_linea" readonly="1"/>
                                    </list>
                                </field>
                                
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="subtotal" readonly="1"/>
                                    <field name="impuesto_total" readonly="1"/>
                                    <field name="total" class="oe_subtotal_footer_separator" readonly="1"/>
                                </group>
                            </page>
                            <page string="Observaciones">
                                <field name="observaciones" readonly="estado != 'borrador'"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View (Principal) -->
        <record id="facturacion_list_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.list</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="paciente_id"/>
                    <field name="propietario_id"/>
                    <field name="total"/>
                    <field name="estado"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="facturacion_search_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.search</field>
            <field name="model">veterinaria.facturacion</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="paciente_id"/>
                    <field name="propietario_id"/>
                    <filter name="borrador" domain="[('estado', '=', 'borrador')]" string="Borrador"/>
                    <filter name="validado" domain="[('estado', '=', 'validado')]" string="Validado"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="facturacion_action" model="ir.actions.act_window">
            <field name="name">Facturación por Servicios</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">veterinaria.facturacion</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva factura por servicios (citas completadas)
                </p>
            </field>
        </record>
    </data>
</odoo>