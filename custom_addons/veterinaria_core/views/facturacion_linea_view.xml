<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View para Linea de Facturacion -->
        <record id="facturacion_linea_form_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.linea.form</field>
            <field name="model">veterinaria.facturacion.linea</field>
            <field name="arch" type="xml">
                <form string="Linea de Facturacion">
                    <sheet>
                        <group>
                            <group>
                                <field name="tipo_linea" string="Tipo"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="cita_id" 
                                       string="Cita Veterinaria" 
                                       invisible="tipo_linea != 'cita'"
                                       domain="[('estado', '=', 'completada'), ('facturada', '=', False), ('propietario_id', '=', parent.propietario_id)]"/>
                                <field name="inventario_id" string="Item" invisible="tipo_linea == 'cita'"/>
                            </group>
                             <group>
                                 <field name="cantidad"/>
                                 <field name="precio_unitario" modifiers='{"readonly":[["tipo_linea","!=","cita"]]}'/>
                                 <field name="impuesto_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                                 <field name="impuesto_linea" readonly="1"/>
                                 <field name="subtotal" readonly="1"/>
                                 <field name="total_linea" readonly="1"/>
                             </group>
                        </group>

                        <group>
                            <field name="descripcion" readonly="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View para Linea de Facturacion (inline) -->
        <record id="facturacion_linea_list_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.linea.list</field>
            <field name="model">veterinaria.facturacion.linea</field>
            <field name="arch" type="xml">
                <list string="Lineas de Facturacion" editable="bottom">
                    <field name="tipo_linea" readonly="1"/>
                    <field name="nombre_item" readonly="1"/>
                    <field name="descripcion" readonly="1"/>
                    <field name="cantidad"/>
                    <field name="precio_unitario" readonly="1"/>
                    <field name="impuesto_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                    <field name="impuesto_linea" string="IVA" readonly="1"/>
                    <field name="subtotal" readonly="1"/>
                </list>
            </field>
        </record>

        <!-- Search View para Linea de Facturacion -->
        <record id="facturacion_linea_search_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.linea.search</field>
            <field name="model">veterinaria.facturacion.linea</field>
            <field name="arch" type="xml">
                <search string="Lineas de Facturacion">
                    <field name="descripcion" string="Descripcion"/>
                    <field name="tipo_linea" string="Tipo"/>
                    <separator/>
                    <filter name="filter_por_factura" string="Por Facturacion" 
                            context="{'group_by': 'facturacion_id'}"/>
                    <filter name="filter_por_tipo" string="Por Tipo" 
                            context="{'group_by': 'tipo_linea'}"/>
                </search>
            </field>
        </record>
    </data>
</odoo>