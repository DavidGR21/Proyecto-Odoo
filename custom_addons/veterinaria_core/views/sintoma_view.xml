<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_veterinaria_sintoma_tree" model="ir.ui.view">
            <field name="name">veterinaria.sintoma.tree</field>
            <field name="model">veterinaria.sintoma</field>
            <field name="arch" type="xml">
                <list string="Síntomas">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_veterinaria_sintoma_form" model="ir.ui.view">
            <field name="name">veterinaria.sintoma.form</field>
            <field name="model">veterinaria.sintoma</field>
            <field name="arch" type="xml">
                <form string="Síntoma">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_veterinaria_sintoma_search" model="ir.ui.view">
            <field name="name">veterinaria.sintoma.search</field>
            <field name="model">veterinaria.sintoma</field>
            <field name="arch" type="xml">
                <search string="Buscar Síntoma">
                    <field name="name" string="Nombre"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_veterinaria_sintoma" model="ir.actions.act_window">
            <field name="name">Síntomas</field>
            <field name="res_model">veterinaria.sintoma</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea un nuevo síntoma
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_veterinaria_sintoma"
            name="Síntomas"
            action="action_veterinaria_sintoma"
            parent="menu_veterinaria_configuracion"
            sequence="10"/>

    </data>
</odoo>
