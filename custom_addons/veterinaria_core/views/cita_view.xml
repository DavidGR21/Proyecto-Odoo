<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- Vista de Formulario para Cita                                -->
        <!-- Flujo: Propietario → Paciente filtrado (#6)                  -->
        <!-- Quick Create de mascota (#9)                                 -->
        <!-- ============================================================ -->
        <record id="view_veterinaria_cita_form" model="ir.ui.view">
            <field name="name">veterinaria.cita.form</field>
            <field name="model">veterinaria.cita</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Cita">
                    <header>
                        <button name="action_completar_cita" type="object" string="✓ Completar" 
                            class="btn btn-success"
                            invisible="estado != 'programada'"/>
                        <button name="action_cancelar_cita" type="object" string="✗ Cancelar" 
                            class="btn btn-danger"
                            invisible="estado not in ('programada', 'completada')"/>
                        <field name="estado" widget="statusbar" statusbar_visible="programada,completada,cancelada,no_asistio"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <!-- Flujo #6: Primero seleccionar propietario, luego mascota filtrada -->
                            <group string="Propietario y Mascota">
                                <field name="propietario_id" string="Propietario"
                                    domain="[('es_propietario', '=', True)]"
                                    context="{'default_es_propietario': True}"
                                    required="1"
                                    options="{'no_quick_create': False}"/>
                                <!-- #9: quick_create de mascota desde agendación -->
                                <field name="paciente_id" required="1" string="Mascota"
                                    domain="[('propietario_id', '=', propietario_id)]"
                                    context="{'default_propietario_id': propietario_id, 'default_propietario_id_name': propietario_id}"
                                    options="{'no_quick_create': False}"/>
                            </group>
                        </group>

                        <group>
                            <group string="Fecha y Hora">
                                <field name="fecha_hora" required="1" widget="datetime"/>
                                <field name="duracion"/>
                            </group>
                            <group string="Datos del Veterinario">
                                <field name="veterinario_id" required="1"/>
                                <field name="servicio_id"/>
                            </group>
                            <group string="Confirmación">
                                <field name="recordatorio_enviado" readonly="1"/>
                                <field name="estado" readonly="1"/>
                            </group>
                        </group>

                        <group string="Motivo de la Cita">
                            <field name="motivo" placeholder="Describa brevemente el motivo de la cita..." required="1"/>
                        </group>



                        <group string="Observaciones">
                            <field name="observaciones" placeholder="Notas adicionales (opcional)"/>
                        </group>

                        <group>
                            <group string="Historia Clínica Relacionada">
                                <field name="historia_clinica_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <!-- Vista de Lista para Cita -->
        <record id="view_veterinaria_cita_list" model="ir.ui.view">
            <field name="name">veterinaria.cita.list</field>
            <field name="model">veterinaria.cita</field>
            <field name="arch" type="xml">
                <list>
                    <field name="fecha_hora"/>
                    <field name="paciente_id"/>
                    <field name="propietario_id"/>
                    <field name="veterinario_id"/>
                    <field name="servicio_id" optional="show"/>
                    <field name="motivo"/>
                    <field name="estado" decoration-success="estado == 'completada'" 
                        decoration-danger="estado == 'cancelada'"/>
                </list>
            </field>
        </record>

        <!-- Vista de Calendario para Cita -->
        <record id="view_veterinaria_cita_calendar" model="ir.ui.view">
            <field name="name">veterinaria.cita.calendar</field>
            <field name="model">veterinaria.cita</field>
            <field name="arch" type="xml">
                <calendar
                    date_start="fecha_hora"
                    date_delay="duracion_horas"
                    string="Citas"
                    mode="month"
                    color="estado"
                    quick_create="false"
                >
                    <field name="paciente_id"/>
                    <field name="propietario_id"/>
                    <field name="veterinario_id"/>
                    <field name="motivo"/>
                    <field name="estado"/>
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <!-- Vista de búsqueda para Cita -->
        <record id="view_veterinaria_cita_search" model="ir.ui.view">
            <field name="name">veterinaria.cita.search</field>
            <field name="model">veterinaria.cita</field>
            <field name="arch" type="xml">
                <search string="Buscar Citas">
                    <field name="paciente_id" string="Buscar por Paciente"/>
                    <field name="veterinario_id" string="Buscar por Veterinario"/>
                    <field name="propietario_id" string="Buscar por Propietario"/>
                    <field name="motivo" string="Buscar por Motivo"/>
                    <separator/>
                    <!-- #8: Filtro para que cada veterinario vea solo sus citas -->
                    <filter name="mis_citas" string="🩺 Mis Citas"
                            domain="[('veterinario_id.user_id', '=', uid)]"/>
                    <separator/>
                    <!-- Filtros por estado -->
                    <filter name="programadas" string="📋 Programadas" domain="[('estado', '=', 'programada')]"/>
                    <!-- #10: Filtro para mostrar citas completadas -->
                    <filter name="completadas" string="✅ Completadas" domain="[('estado', '=', 'completada')]"/>
                    <filter name="canceladas" string="❌ Canceladas" domain="[('estado', '=', 'cancelada')]"/>
                    <filter name="no_asistio" string="⚠️ No Asistió" domain="[('estado', '=', 'no_asistio')]"/>
                    <separator/>
                    <filter name="mis_citas" string="👨‍⚕️ Mis Citas" domain="[('veterinario_id.user_id', '=', uid)]"/>
                    <filter name="todas_citas" string="🌎 Todas las citas (Generales)" domain="[(1, '=', 1)]"/>
                    <separator/>
                    <!-- #9: Filtros por fechas claros y específicos -->
                    <filter string="📅 Citas de Hoy" name="filter_hoy"
                            domain="[('fecha_hora', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('fecha_hora', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="📅 Citas Últimos 7 Días" name="filter_semana"
                            domain="[('fecha_hora', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="📅 Citas de Este Mes" name="filter_mes"
                            domain="[('fecha_hora', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <filter string="🕐 Creadas Hoy" name="filter_creadas_hoy"
                            domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="🕐 Creadas Últimos 7 Días" name="filter_creadas_semana"
                            domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="🕐 Creadas Este Mes" name="filter_creadas_mes"
                            domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Veterinario" name="group_by_vet" context="{'group_by': 'veterinario_id'}"/>
                        <filter string="Estado" name="group_by_estado" context="{'group_by': 'estado'}"/>
                        <filter string="Paciente" name="group_by_paciente" context="{'group_by': 'paciente_id'}"/>
                        <filter string="Propietario" name="group_by_propietario" context="{'group_by': 'propietario_id'}"/>
                        <filter string="Servicio" name="group_by_servicio" context="{'group_by': 'servicio_id'}"/>
                        <filter string="Fecha de Cita (por mes)" name="group_by_fecha" context="{'group_by': 'fecha_hora:month'}"/>
                        <filter string="Fecha de Creación (por mes)" name="group_by_create" context="{'group_by': 'create_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción para Cita Original -->
        <record id="action_veterinaria_cita" model="ir.actions.act_window">
            <field name="name">Citas</field>
            <field name="res_model">veterinaria.cita</field>
            <field name="view_mode">list,calendar,form</field>
            <field name="context">{'default_estado': 'programada', 'default_duracion': '1.0'}</field>
        </record>

        <!-- Acción para Mis Citas -->
        <record id="action_veterinaria_mis_citas" model="ir.actions.act_window">
            <field name="name">Mis Citas</field>
            <field name="res_model">veterinaria.cita</field>
            <field name="view_mode">list,calendar,form</field>
            <field name="domain">[('veterinario_id.user_id', '=', uid)]</field>
            <field name="context">{'default_estado': 'programada', 'default_duracion': '1.0'}</field>
        </record>

        <!-- Acción para Todas las Citas -->
        <record id="action_veterinaria_todas_citas" model="ir.actions.act_window">
            <field name="name">Todas las Citas</field>
            <field name="res_model">veterinaria.cita</field>
            <field name="view_mode">list,calendar,form</field>
            <field name="context">{'default_estado': 'programada', 'default_duracion': '1.0'}</field>
        </record>
    </data>
</odoo>
