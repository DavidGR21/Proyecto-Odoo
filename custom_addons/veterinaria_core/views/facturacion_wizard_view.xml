<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Wizard: Agregar Linea Individual -->
        <record id="facturacion_linea_wizard_form_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.linea.wizard.form</field>
            <field name="model">veterinaria.facturacion.linea.wizard</field>
            <field name="arch" type="xml">
                <form string="Agregar Linea de Facturacion">
                    <sheet>
                        <h2>Agregar item a la factura</h2>
                        <field name="facturacion_id" invisible="1"/>
                        <group>
                            <group>
                                <field name="tipo_linea" string="Tipo"/>
                                <field name="cita_id" string="Cita Veterinaria" invisible="tipo_linea != 'cita'"/>
                                <field name="inventario_id" string="Item" invisible="tipo_linea == 'cita'"/>
                            </group>
                            <group>
                                <field name="cantidad"/>
                                <field name="precio_unitario"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_agregar_linea" string="Agregar"
                                type="object" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="facturacion_linea_wizard_action" model="ir.actions.act_window">
            <field name="name">Agregar Linea de Facturacion</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">veterinaria.facturacion.linea.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Wizard: Agregar Multiples Lineas -->
        <record id="facturacion_multilinea_wizard_form_view" model="ir.ui.view">
            <field name="name">veterinaria.facturacion.multilinea.wizard.form</field>
            <field name="model">veterinaria.facturacion.multilinea.wizard</field>
            <field name="arch" type="xml">
                <form string="Agregar Multiples Items">
                    <sheet>
                        <h2>Agregar multiples items a la factura</h2>
                        <field name="facturacion_id" invisible="1"/>

                        <group>
                            <field name="tipo_documento" required="1" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="cantidad_default"/>
                        </group>

                        <group>
                            <!-- Citas -->
                            <field name="cita_ids" nolabel="1" colspan="2"
                                   invisible="tipo_documento != 'cita'">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="fecha_hora"/>
                                    <field name="paciente_id"/>
                                    <field name="veterinario_id"/>
                                    <field name="estado"/>
                                </list>
                            </field>
                            <!-- Items de Inventario -->
                            <field name="inventario_ids" nolabel="1" colspan="2"
                                   invisible="tipo_documento == 'cita'">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tipo_inventario"/>
                                    <field name="precio_venta"/>
                                    <field name="cantidad_stock"/>
                                </list>
                            </field>                        </group>
                    </sheet>
                    <footer>
                        <button name="action_agregar_multiples_lineas"
                                string="Agregar Seleccionados"
                                type="object" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="facturacion_multilinea_wizard_action" model="ir.actions.act_window">
            <field name="name">Agregar Multiples Lineas</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">veterinaria.facturacion.multilinea.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
