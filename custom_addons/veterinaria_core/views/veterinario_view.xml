<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de Formulario para Veterinario -->
        <record id="view_veterinaria_veterinario_form" model="ir.ui.view">
            <field name="name">veterinaria.veterinario.form</field>
            <field name="model">veterinaria.veterinario</field>
            <field name="arch" type="xml">
                <form string="Veterinario">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ej: Dr. Juan Pérez"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Información Profesional">
                                <field name="especialidad_id" required="1"/>
                                <field name="matricula_profesional"/>
                                <field name="horario_inicio"/>
                                <field name="horario_fin"/>
                                <field name="dias_disponibles"/>
                            </group>
                            <group string="Horario">
                                <field name="observaciones_horario" placeholder="Ej: Atencion solo por la manana"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de Lista para Veterinario -->
        <record id="view_veterinaria_veterinario_list" model="ir.ui.view">
            <field name="name">veterinaria.veterinario.list</field>
            <field name="model">veterinaria.veterinario</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="especialidad_id"/>
                    <field name="matricula_profesional"/>
                    <field name="horario_inicio"/>
                    <field name="horario_fin"/>
                    <field name="dias_disponibles"/>
                </list>
            </field>
        </record>

        <!-- Vista de Búsqueda para Veterinario -->
        <record id="view_veterinaria_veterinario_search" model="ir.ui.view">
            <field name="name">veterinaria.veterinario.search</field>
            <field name="model">veterinaria.veterinario</field>
            <field name="arch" type="xml">
                <search string="Veterinarios">
                    <field name="name"/>
                    <field name="especialidad_id"/>
                </search>
            </field>
        </record>
    </data>
</odoo>