<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- Extensión de la vista de Cita para gestionar Recetas        -->
        <!-- ============================================================ -->
        <record id="view_veterinaria_cita_form_receta_extension" model="ir.ui.view">
            <field name="name">veterinaria.cita.form.receta.extension</field>
            <field name="model">veterinaria.cita</field>
            <field name="inherit_id" ref="veterinaria_core.view_veterinaria_cita_form"/>
            <field name="arch" type="xml">
                <!-- Solución #1: Mover botón al Header principal -->
                <xpath expr="//header" position="inside">
                    <field name="receta_count" invisible="1"/>
                    <button name="action_crear_receta"
                            string="➕ Emitir Receta"
                            type="object"
                            class="btn btn-primary"
                            invisible="estado != 'completada' or receta_count > 0"/>
                </xpath>

            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Vista Formulario de Receta (Detalle)                        -->
        <!-- ============================================================ -->
        <record id="view_veterinaria_receta_form" model="ir.ui.view">
            <field name="name">veterinaria.receta.form</field>
            <field name="model">veterinaria.receta</field>
            <field name="arch" type="xml">
                <form string="Receta Médica">
                    <field name="facturada" invisible="1"/>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                            <div class="alert alert-info" role="alert" invisible="not facturada">
                                <strong>Receta Facturada:</strong> Esta prescripción ya ha sido procesada por administración y no puede ser modificada.
                            </div>
                        </div>

                        <group>
                            <group string="Información de la Cita">
                                <field name="cita_id" readonly="1"/>
                                <field name="fecha_emision" readonly="1"/>
                                <field name="veterinario_id" readonly="1"/>
                            </group>
                            <group string="Paciente">
                                <field name="paciente_id" readonly="1"/>
                                <field name="historia_clinica_id" readonly="1"/>
                            </group>
                        </group>

                        <group string="Diagnóstico" readonly="facturada">
                            <field name="diagnostico" nolabel="1"
                                   placeholder="Diagnóstico clínico resumido..."/>
                        </group>

                        <notebook readonly="facturada">
                            <page string="💊 Tratamiento" name="medicamentos">
                                <field name="linea_ids" readonly="facturada">
                                    <!-- Bloqueo dinámico de edición en la lista -->
                                    <list string="Medicamentos" 
                                          create="not facturada" 
                                          delete="not facturada" 
                                          edit="not facturada">
                                        <field name="nombre_medicamento_display" string="Medicamento"/>
                                        <field name="dosis" string="Dosis"/>
                                        <field name="frecuencia_horas" string="Cada (h)"/>
                                        <field name="duracion_dias" string="Días"/>
                                        <field name="cantidad_total" string="Total" decoration-bf="1"/>
                                    </list>

                                    <!-- Solución #2: Formulario interno para elegir origen sin duplicar columnas -->
                                    <form string="Línea de Tratamiento">
                                        <group>
                                            <group string="Identificación del Medicamento">
                                                <field name="tipo_origen" widget="radio" options="{'horizontal': true}"/>
                                                <field name="medicamento_id" 
                                                       string="Medicamento (Inventario)"
                                                       invisible="tipo_origen != 'inventario'"
                                                       options="{'no_create': True}"/>
                                                <field name="medicamento_texto" 
                                                       string="Medicamento (Exterior)"
                                                       invisible="tipo_origen == 'inventario'"/>
                                            </group>
                                            <group string="Dosificación">
                                                <field name="dosis" string="Dosis (unidades/ml)"/>
                                                <field name="frecuencia_horas" string="Cada (horas)"/>
                                                <field name="duracion_dias" string="Duración (días)"/>
                                                <field name="cantidad_total" string="Cantidad Total a Entregar" readonly="1"/>
                                            </group>
                                        </group>
                                    </form>
                                </field>

                                <group string="Recomendaciones e Instrucciones Adicionales">
                                    <field name="observaciones_adicionales" nolabel="1"
                                           placeholder="Ej: Reposo absoluto, evitar luz solar..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Lista de Recetas -->
        <record id="view_veterinaria_receta_list" model="ir.ui.view">
            <field name="name">veterinaria.receta.list</field>
            <field name="model">veterinaria.receta</field>
            <field name="arch" type="xml">
                <list decoration-info="True" string="Recetas Médicas">
                    <field name="name"/>
                    <field name="cita_id"/>
                    <field name="paciente_id"/>
                    <field name="veterinario_id"/>
                    <field name="fecha_emision"/>
                </list>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_veterinaria_receta" model="ir.actions.act_window">
            <field name="name">Recetas Médicas</field>
            <field name="res_model">veterinaria.receta</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
