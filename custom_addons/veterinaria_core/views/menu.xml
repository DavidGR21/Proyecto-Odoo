<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- ACCIONES                                                      -->
        <!-- ============================================================ -->
        <record id="action_veterinaria_paciente" model="ir.actions.act_window">
            <field name="name">Pacientes</field>
            <field name="res_model">veterinaria.paciente</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_historia_clinica" model="ir.actions.act_window">
            <field name="name">Historia Clínica</field>
            <field name="res_model">veterinaria.historia_clinica</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_medicamento" model="ir.actions.act_window">
            <field name="name">Medicamentos</field>
            <field name="res_model">veterinaria.medicamento</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_cita" model="ir.actions.act_window">
            <field name="name">Citas</field>
            <field name="res_model">veterinaria.cita</field>
            <field name="view_mode">list,calendar,form</field>
        </record>

        <record id="action_veterinaria_producto" model="ir.actions.act_window">
            <field name="name">Productos Y Servicios</field>
            <field name="res_model">veterinaria.producto</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_servicio" model="ir.actions.act_window">
            <field name="name">Servicios</field>
            <field name="res_model">veterinaria.servicio</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_venta" model="ir.actions.act_window">
            <field name="name">Ventas de Productos</field>
            <field name="res_model">veterinaria.venta</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_facturacion" model="ir.actions.act_window">
            <field name="name">Facturación por Servicios</field>
            <field name="res_model">veterinaria.facturacion</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_veterinaria_veterinario" model="ir.actions.act_window">
            <field name="name">Veterinarios</field>
            <field name="res_model">veterinaria.veterinario</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ============================================================ -->
        <!-- MENÚ RAÍZ — Visible para cualquier grupo de veterinaria      -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_root" name="Veterinaria" sequence="50"
            groups="group_veterinaria_recepcionista"/>
        
        <!-- ============================================================ -->
        <!-- 1. GESTIÓN CLÍNICA — Recepcionista y superiores              -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_gestion" name="Gestión Clínica" 
            parent="menu_veterinaria_root" sequence="10"
            groups="group_veterinaria_recepcionista"/>
        
        <menuitem id="menu_veterinaria_pacientes" name="Pacientes" 
            parent="menu_veterinaria_gestion" sequence="10" action="action_veterinaria_paciente"
            groups="group_veterinaria_recepcionista"/>

        <menuitem id="menu_veterinaria_propietarios" name="Dueños" 
            parent="menu_veterinaria_gestion" sequence="15" action="action_veterinaria_propietario"
            groups="group_veterinaria_recepcionista"/>

        <menuitem id="menu_veterinaria_veterinarios" name="Veterinarios" 
            parent="menu_veterinaria_gestion" sequence="18" action="action_veterinaria_veterinario"
            groups="group_veterinaria_recepcionista"/>

        <menuitem id="menu_veterinaria_especialidades" name="Especialidades" 
            parent="menu_veterinaria_gestion" sequence="19" action="action_veterinaria_especialidad"
            groups="group_veterinaria_admin"/>
        
        <menuitem id="menu_veterinaria_historia" name="Historia Clínica"
            parent="menu_veterinaria_gestion" sequence="20" action="action_veterinaria_historia_clinica"
            groups="group_veterinaria_veterinario"/>

        <menuitem id="menu_mi_perfil_veterinario"
                  name="Mi Perfil"
                  parent="menu_veterinaria_gestion"
                  action="action_mi_perfil_veterinario"
                  sequence="100"
                  groups="veterinaria_core.group_veterinaria_veterinario"/>

        <!-- ============================================================ -->
        <!-- 2. CITAS Y CALENDARIO — Recepcionista y superiores (#11)     -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_citas" name="Agenda / Citas" 
            parent="menu_veterinaria_root" sequence="20" action="action_veterinaria_cita_server"
            groups="group_veterinaria_recepcionista"/>
        
        <!-- ============================================================ -->
        <!-- 3. INVENTARIO — Solo Admin                                    -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_inventario" name="Inventario" 
            parent="menu_veterinaria_root" sequence="30" action="action_veterinaria_inventario"
            groups="group_veterinaria_admin"/>
        
        <!-- ============================================================ -->
        <!-- 4. FACTURACIÓN Y VENTAS — Solo Admin                         -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_facturacion_ventas" name="Facturación y Ventas" 
            parent="menu_veterinaria_root" sequence="40" action="action_veterinaria_facturacion"
            groups="group_veterinaria_admin"/>
        
        <!-- ============================================================ -->
        <!-- 5. CRM — Solo Admin                                           -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_crm" name="CRM" 
            parent="menu_veterinaria_root" sequence="60" action="crm.crm_lead_action_pipeline"
            groups="group_veterinaria_admin"/>
        
        <!-- ============================================================ -->
        <!-- 6. CONFIGURACIÓN — Solo Admin                                -->
        <!-- ============================================================ -->
        <menuitem id="menu_veterinaria_configuracion" name="Configuración" 
            parent="menu_veterinaria_root" sequence="200"
            groups="group_veterinaria_admin"/>
    </data>
</odoo>
