<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_carnet_vacunas" model="ir.actions.report">
        <field name="name">Carnet de Vacunas</field>
        <field name="model">veterinaria.paciente</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">veterinaria_core.report_carnet_vacunas_template</field>
        <field name="report_file">veterinaria_core.report_carnet_vacunas_template</field>
        <field name="print_report_name">'Carnet_Vacunas_%s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_veterinaria_paciente"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_carnet_vacunas_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=(doc.propietario_id.lang or 'es_ES'))"/>
            <div class="page">
                <style>
                    /* Remove top padding so content starts right at the top */
                    .page { margin-top: 0 !important; padding-top: 0 !important; }

                    /* ── Passport cover card ── */
                    .vp-passport {
                        background-color: #0d3b5e;
                        border-radius: 18px;
                        padding: 26px 30px 0 30px;
                        color: #fff;
                        position: relative;
                        overflow: hidden;
                    }
                    .vp-paw-bg {
                        position: absolute;
                        right: -15px;
                        top: -45px;
                        font-size: 220px;
                        opacity: 0.07;
                        color: #fff;
                        line-height: 1;
                    }
                    .vp-brand-name {
                        font-size: 20px;
                        font-weight: bold;
                        letter-spacing: 0.02em;
                        margin-bottom: 3px;
                    }
                    .vp-brand-sub {
                        font-size: 9.5px;
                        opacity: 0.72;
                        text-transform: uppercase;
                        letter-spacing: 0.1em;
                    }
                    .vp-badge {
                        display: inline-block;
                        padding: 5px 14px;
                        border-radius: 20px;
                        font-size: 10.5px;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 0.05em;
                    }
                    .vp-badge-ok   { background: #27ae60; }
                    .vp-badge-bad  { background: #e74c3c; }
                    .vp-badge-none { background-color: #1a5c8a; border: 1px solid #4a8ab0; }
                    .vp-photo-box {
                        width: 148px;
                        height: 148px;
                        border-radius: 14px;
                        overflow: hidden;
                        border: 3px solid #4a8ab0;
                        background-color: #1a5c8a;
                        text-align: center;
                        vertical-align: middle;
                    }
                    .vp-pet-name {
                        font-size: 30px;
                        font-weight: bold;
                        margin: 0 0 13px 0;
                        line-height: 1.15;
                    }
                    .vp-data-tbl { width: 100%; border-collapse: collapse; }
                    .vp-data-tbl tr { border-bottom: 1px solid rgba(255,255,255,0.12); }
                    .vp-data-tbl td { padding: 5px 0; font-size: 12px; vertical-align: middle; }
                    .vp-lbl {
                        width: 90px;
                        font-size: 9.5px;
                        text-transform: uppercase;
                        letter-spacing: 0.04em;
                        opacity: 0.65;
                        padding-right: 6px;
                    }
                    .vp-val { font-weight: 600; }
                    .vp-allergy-strip {
                        background-color: #4a1a1a;
                        border: 1px solid #e74c3c;
                        border-radius: 8px;
                        padding: 9px 14px;
                        margin-top: 14px;
                        font-size: 11px;
                    }
                    .vp-allergy-label {
                        display: block;
                        font-size: 9px;
                        text-transform: uppercase;
                        letter-spacing: 0.07em;
                        opacity: 0.7;
                        margin-bottom: 3px;
                    }
                    .vp-passport-footer {
                        background-color: #092840;
                        padding: 11px 30px;
                        margin: 20px -30px 0 -30px;
                        font-size: 11px;
                    }

                    /* ── Vaccine table page ── */
                    .vp-vac-hdr {
                        background-color: #0d3b5e;
                        border-radius: 8px;
                        padding: 10px 16px;
                        color: #fff;
                        font-size: 13px;
                        font-weight: bold;
                        margin-bottom: 16px;
                    }
                    .vp-vac-tbl { width: 100%; border-collapse: collapse; font-size: 11px; }
                    .vp-vac-tbl thead th {
                        background: #0d3b5e;
                        color: #fff;
                        padding: 9px 10px;
                        text-align: left;
                        font-size: 10.5px;
                        font-weight: bold;
                    }
                    .vp-vac-tbl tbody td {
                        border-bottom: 1px solid #e4eef5;
                        padding: 8px 10px;
                        color: #2c3e50;
                        vertical-align: top;
                    }
                    .vp-vac-tbl tbody tr.vp-even td { background: #f7fbfe; }
                    .vp-vac-name { font-weight: bold; color: #0d3b5e; }
                    .vp-next-date { color: #06A77D; font-weight: bold; }
                    .vp-empty {
                        text-align: center;
                        color: #8e9fb0;
                        font-style: italic;
                        padding: 30px;
                        border: 1px dashed #e4eef5;
                        border-radius: 8px;
                        margin: 10px 0;
                    }
                    .vp-doc-footer {
                        text-align: center;
                        font-size: 10px;
                        color: #8e9fb0;
                        margin-top: 30px;
                        padding-top: 12px;
                        border-top: 1px solid #e4eef5;
                    }
                </style>

                <!-- ══════════════════ COVER / PASSPORT ══════════════════ -->
                <div class="vp-passport">

                    <!-- Decorative background paw -->
                    <div class="vp-paw-bg"><i class="fa fa-paw"/></div>

                    <!-- Clinic brand + vaccination status -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="vertical-align:top;">
                                <div class="vp-brand-name">
                                    <i class="fa fa-paw" style="margin-right:7px;"/>VitalPet
                                </div>
                                <div class="vp-brand-sub">Pasaporte Sanitario de Mascota</div>
                            </td>
                            <td style="text-align:right; vertical-align:top;">
                                <t t-if="doc.estado_vacunacion == 'al_dia'">
                                    <span class="vp-badge vp-badge-ok">
                                        <i class="fa fa-check" style="margin-right:4px;"/>Al dia
                                    </span>
                                </t>
                                <t t-elif="doc.estado_vacunacion == 'atrasado'">
                                    <span class="vp-badge vp-badge-bad">
                                        <i class="fa fa-exclamation-triangle" style="margin-right:4px;"/>Atrasado
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="vp-badge vp-badge-none">Sin vacunas</span>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- Pet photo + data columns -->
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <!-- Photo -->
                            <td style="width:158px; vertical-align:top;">
                                <t t-if="doc.foto">
                                    <div class="vp-photo-box"
                                         t-attf-style="background-image:url('#{image_data_uri(doc.foto)}'); background-size:cover; background-position:center; background-repeat:no-repeat; width:148px; height:148px; border-radius:14px; border:3px solid #4a8ab0;"/>
                                </t>
                                <t t-else="">
                                    <div class="vp-photo-box" style="width:148px; height:148px; line-height:148px;">
                                        <i class="fa fa-paw" style="font-size:52px; opacity:0.4; vertical-align:middle;"/>
                                    </div>
                                </t>
                            </td>
                            <!-- Info -->
                            <td style="padding-left:26px; vertical-align:top;">
                                <div class="vp-pet-name" t-out="doc.name"/>
                                <table class="vp-data-tbl">
                                    <tr>
                                        <td class="vp-lbl">Especie</td>
                                        <td class="vp-val"
                                            t-out="dict(doc._fields['especie'].selection).get(doc.especie, '-')"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Raza</td>
                                        <td class="vp-val" t-out="doc.raza or '-'"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Nacimiento</td>
                                        <td class="vp-val" t-out="doc.fecha_nacimiento or '-'"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Peso</td>
                                        <td class="vp-val"><t t-out="doc.peso or 0"/> kg</td>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Microchip</td>
                                        <td class="vp-val" t-out="doc.microchip or '-'"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Propietario</td>
                                        <td class="vp-val" t-out="doc.propietario_id.name or '-'"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Contacto</td>
                                        <td class="vp-val"
                                            t-out="doc.propietario_id.phone or doc.propietario_id.mobile or '-'"/>
                                    </tr>
                                    <tr>
                                        <td class="vp-lbl">Vacunas</td>
                                        <td class="vp-val">
                                            <t t-out="len(doc.vacuna_aplicada_ids)"/> registrada(s)
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Allergies strip (only if set) -->
                    <t t-if="doc.alergias">
                        <div class="vp-allergy-strip">
                            <span class="vp-allergy-label">
                                <i class="fa fa-exclamation-circle" style="margin-right:4px;"/>Alergias registradas
                            </span>
                            <t t-out="doc.alergias"/>
                        </div>
                    </t>

                    <!-- Footer bar -->
                    <div class="vp-passport-footer">
                        <span>ID Mascota: PET-<t t-out="'%06d' % doc.id"/></span>
                        <span style="float:right;">VitalPet - Clinica Veterinaria</span>
                    </div>
                </div>
                <!-- END cover -->

                <!-- Force vaccine history to a new page -->
                <div style="page-break-before: always;"/>

                <!-- ══════════════════ VACCINE HISTORY ══════════════════ -->
                <div class="vp-vac-hdr">
                    <i class="fa fa-medkit" style="margin-right:8px;"/>
                    Historial de Vacunacion — <t t-out="doc.name"/>
                </div>

                <t t-if="doc.vacuna_aplicada_ids">
                    <table class="vp-vac-tbl">
                        <thead>
                            <tr>
                                <th style="width:22%;">Vacuna</th>
                                <th style="width:13%;">Fecha Aplic.</th>
                                <th style="width:17%;">Veterinario</th>
                                <th style="width:10%;">Lote</th>
                                <th style="width:13%;">Proxima Dosis</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.vacuna_aplicada_ids" t-as="v"
                                t-attf-class="#{'' if v_index % 2 == 0 else 'vp-even'}">
                                <td><span class="vp-vac-name" t-out="v.vacuna_id.name"/></td>
                                <td t-out="v.fecha_aplicacion"/>
                                <td t-out="v.veterinario_id.name or '-'"/>
                                <td t-out="v.lote or '-'"/>
                                <td><span class="vp-next-date" t-out="v.proxima_dosis or '-'"/></td>
                                <td t-out="v.observaciones or '-'"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <div class="vp-empty">
                        <i class="fa fa-info-circle" style="margin-right:6px;"/>
                        Sin vacunas aplicadas registradas para esta mascota.
                    </div>
                </t>

                <div class="vp-doc-footer">
                    Documento generado por VitalPet - Clinica Veterinaria
                </div>
            </div>
        </t>
    </template>

    <template id="report_carnet_vacunas_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="veterinaria_core.report_carnet_vacunas_document"/>
            </t>
        </t>
    </template>

</odoo>
