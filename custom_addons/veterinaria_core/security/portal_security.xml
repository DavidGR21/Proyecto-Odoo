<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Record rules para el grupo Cliente Portal.
            La cadena de propiedad es:
                propietario_id (res.partner) -> user_ids (res.users)
            Por eso usamos: ('propietario_id.user_ids', 'in', [user.id]).
            Para modelos enlazados a través de paciente_id, se encadena.
        -->

        <!-- Mascotas: el cliente solo ve las suyas -->
        <record id="rule_paciente_cliente_portal" model="ir.rule">
            <field name="name">Cliente Portal: Mis mascotas</field>
            <field name="model_id" ref="model_veterinaria_paciente"/>
            <field name="domain_force">[('propietario_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_veterinaria_cliente'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Historia clínica: solo de mascotas propias -->
        <record id="rule_historia_cliente_portal" model="ir.rule">
            <field name="name">Cliente Portal: Mi historia clínica</field>
            <field name="model_id" ref="model_veterinaria_historia_clinica"/>
            <field name="domain_force">[('paciente_id.propietario_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_veterinaria_cliente'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

