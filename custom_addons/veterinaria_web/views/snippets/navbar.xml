<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Navbar VitalPet.
        - header#top de Odoo se oculta con CSS: header#top { display:none !important }
        - Topbar + navbar se inyectan ANTES del <main> (xpath valido en cadena heredada).
    -->
    <template id="vitalpet_navbar" name="VitalPet Navbar" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']/main" position="before">
            <t t-if="not no_header">
                <!-- Topbar de informacion (solo escritorio) -->
                <div class="vp-topbar d-none d-lg-block">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="vp-topbar-item">
                                    <i class="fa fa-phone me-1"/> +593 99 123 4567
                                </span>
                                <span class="vp-topbar-item ms-3">
                                    <i class="fa fa-envelope me-1"/> info@vitalpet.com
                                </span>
                            </div>
                            <div class="col text-end">
                                <span class="vp-topbar-item">
                                    <i class="fa fa-clock-o me-1"/> Lun-Sab: 8:00-18:00
                                </span>
                                <a href="https://wa.me/593991234567" target="_blank"
                                   class="vp-topbar-social ms-2" aria-label="WhatsApp">
                                    <i class="fa fa-whatsapp"/>
                                </a>
                                <a href="#" class="vp-topbar-social ms-1" aria-label="Facebook">
                                    <i class="fa fa-facebook"/>
                                </a>
                                <a href="#" class="vp-topbar-social ms-1" aria-label="Instagram">
                                    <i class="fa fa-instagram"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navbar principal VitalPet -->
                <nav class="vp-navbar-main" id="vp-navbar"
                     role="navigation" aria-label="Navegacion principal">
                    <div class="container">
                        <div class="vp-nav-inner">
                            <a href="/" class="vp-logo">
                                <i class="fa fa-paw"/> Vital<span>Pet</span>
                            </a>
                            <ul class="vp-nav-links" id="vp-nav-links">
                                <li>
                                    <a href="/"
                                       t-att-class="'vp-nav-link' + (' vp-nav-active' if request.httprequest.path == '/' else '')">
                                        Inicio
                                    </a>
                                </li>
                                <li>
                                    <a href="/servicios"
                                       t-att-class="'vp-nav-link' + (' vp-nav-active' if request.httprequest.path.startswith('/servicios') else '')">
                                        Servicios
                                    </a>
                                </li>
                                <li>
                                    <a href="/nosotros"
                                       t-att-class="'vp-nav-link' + (' vp-nav-active' if request.httprequest.path.startswith('/nosotros') else '')">
                                        Nosotros
                                    </a>
                                </li>
                                <t t-if="request.env.user._is_public()">
                                    <li>
                                        <a href="/web/login" class="vp-nav-link">
                                            <i class="fa fa-sign-in me-1"/> Iniciar Sesión
                                        </a>
                                    </li>
                                </t>
                                <t t-else="">
                                    <li class="vp-dropdown">
                                        <style>
                                            .vp-dropdown { position: relative; display: inline-block; }
                                            .vp-dropdown-menu {
                                                display: none;
                                                position: absolute;
                                                right: 0;
                                                background-color: #ffffff;
                                                min-width: 170px;
                                                box-shadow: 0px 8px 24px rgba(0,0,0,0.08);
                                                border: 1px solid #e2e8f0;
                                                border-radius: 12px;
                                                z-index: 1000;
                                                padding: 6px 0;
                                                margin-top: 6px;
                                            }
                                            .vp-dropdown-menu a {
                                                color: #2d3748 !important;
                                                padding: 10px 16px !important;
                                                display: block !important;
                                                font-size: 0.9rem !important;
                                                font-weight: 500 !important;
                                                border-radius: 0 !important;
                                                background: transparent !important;
                                            }
                                            .vp-dropdown-menu a:hover {
                                                background-color: rgba(64,194,214,0.08) !important;
                                                color: #2e86ab !important;
                                            }
                                            .vp-dropdown:hover .vp-dropdown-menu { display: block; }
                                            @media (max-width: 991px) {
                                                .vp-dropdown-menu {
                                                    position: static;
                                                    display: block;
                                                    box-shadow: none;
                                                    border: none;
                                                    padding-left: 15px;
                                                    margin-top: 0;
                                                }
                                                .vp-dropdown-menu a {
                                                    padding: 8px 16px !important;
                                                }
                                            }
                                        </style>
                                        <a href="/my" class="vp-nav-link dropdown-toggle">
                                            <i class="fa fa-user me-1"/> Mi Portal
                                        </a>
                                        <div class="vp-dropdown-menu">
                                            <a href="/my"><i class="fa fa-th-large me-2"/> Mi Portal</a>
                                            <a href="/web/session/logout?redirect=/" class="text-danger"><i class="fa fa-sign-out me-2"/> Cerrar Sesión</a>
                                        </div>
                                    </li>
                                </t>
                                <li>
                                    <a href="/contacto"
                                       t-att-class="'vp-nav-cta' + (' vp-nav-cta-active' if request.httprequest.path.startswith('/contacto') else '')">
                                        <i class="fa fa-calendar me-1"/> Agendar Cita
                                    </a>
                                </li>
                            </ul>
                            <button class="vp-hamburger" id="vp-hamburger"
                                    aria-label="Abrir menu" aria-expanded="false">
                                <span></span>
                                <span></span>
                                <span></span>
                            </button>
                        </div>
                    </div>
                </nav>
            </t>
        </xpath>
    </template>
</odoo>
