<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Página de Servicios - VitalPet
        Grid de 8 servicios + sección de planes/precios + CTA
    -->
    <template id="pagina_servicios" name="VitalPet - Servicios">
        <t t-call="website.layout">
            <t t-set="title" t-value="titulo_pagina"/>
            <div id="wrap" class="vitalpet-servicios">

                <!-- PAGE HEADER -->
                <section class="vp-page-header">
                    <div class="container">
                        <span class="vp-section-badge">Lo que ofrecemos</span>
                        <h1>Nuestros <span class="vp-gradient-text">Servicios</span></h1>
                        <p>Atención veterinaria integral con tecnología de vanguardia</p>
                        <div class="vp-breadcrumb">
                            <a href="/">Inicio</a>
                            <span>›</span>
                            <span style="color:rgba(255,255,255,0.6)">Servicios</span>
                        </div>
                    </div>
                </section>

                <!-- GRID DE SERVICIOS -->
                <section class="vp-section vp-section-servicios-grid">
                    <div class="container">
                        <div class="text-center mb-5" data-vp-animate="fade-up">
                            <span class="vp-section-badge">Catálogo Completo</span>
                            <h2 class="vp-section-title">
                                Todo lo que tu mascota
                                <span class="vp-gradient-text">necesita</span>
                            </h2>
                            <p class="vp-section-subtitle">
                                Contamos con especialistas y equipos de última generación
                                para brindar la mejor atención.
                            </p>
                        </div>

                        <div class="row g-4">
                            <t t-foreach="servicios" t-as="srv">
                                <div class="col-md-6 col-lg-3"
                                     data-vp-animate="fade-up"
                                     t-att-data-vp-delay="str(srv_index * 75 + 100)">
                                    <div class="vp-service-card">
                                        <div class="vp-service-icon-wrap"
                                             t-att-style="'background: linear-gradient(135deg, ' + srv['color'] + ', ' + srv['color'] + 'cc)'">
                                            <i t-att-class="'fa ' + srv['icono']"/>
                                        </div>
                                        <h4 t-out="srv['titulo']"/>
                                        <p t-out="srv['descripcion']"/>
                                        <a href="/contacto" class="vp-service-link">
                                            Agendar <i class="fa fa-arrow-right"/>
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- PLANES -->
                <section class="vp-section vp-section-planes">
                    <div class="container">
                        <div class="text-center mb-5" data-vp-animate="fade-up">
                            <span class="vp-section-badge">Membresías</span>
                            <h2 class="vp-section-title">
                                Planes de
                                <span class="vp-gradient-text">cuidado integral</span>
                            </h2>
                            <p class="vp-section-subtitle">
                                Elige el plan que mejor se adapte a las necesidades de tu mascota.
                            </p>
                        </div>

                        <div class="row g-4 justify-content-center">
                            <!-- Plan Básico -->
                            <div class="col-lg-4 col-md-6" data-vp-animate="fade-up" data-vp-delay="100">
                                <div class="vp-plan-card">
                                    <h4>Plan Básico</h4>
                                    <p style="color:var(--vp-gray);font-size:0.88rem">Ideal para mascotas sanas</p>
                                    <div class="vp-plan-price"><span class="vp-price-symbol">$</span>29</div>
                                    <div class="vp-plan-period">por mes / mascota</div>
                                    <ul class="vp-plan-features">
                                        <li><i class="fa fa-check"/> 1 consulta mensual</li>
                                        <li><i class="fa fa-check"/> Historial digital</li>
                                        <li><i class="fa fa-check"/> Recordatorios de vacunas</li>
                                        <li><i class="fa fa-check"/> App móvil</li>
                                        <li class="disabled"><i class="fa fa-times"/> Cirugías incluidas</li>
                                        <li class="disabled"><i class="fa fa-times"/> Laboratorio incluido</li>
                                    </ul>
                                    <a href="/contacto" class="vp-btn-outline" style="width:100%;justify-content:center">
                                        Contratar Plan
                                    </a>
                                </div>
                            </div>

                            <!-- Plan Pro (featured) -->
                            <div class="col-lg-4 col-md-6" data-vp-animate="fade-up" data-vp-delay="200">
                                <div class="vp-plan-card featured">
                                    <div class="vp-plan-badge">⭐ Más Popular</div>
                                    <h4 style="color:#fff">Plan Pro</h4>
                                    <p style="color:rgba(255,255,255,0.7);font-size:0.88rem">El más elegido por nuestros clientes</p>
                                    <div class="vp-plan-price" style="color:#fff"><span class="vp-price-symbol">$</span>59</div>
                                    <div class="vp-plan-period" style="color:rgba(255,255,255,0.7)">por mes / mascota</div>
                                    <ul class="vp-plan-features" style="color:#fff">
                                        <li><i class="fa fa-check"/> Consultas ilimitadas</li>
                                        <li><i class="fa fa-check"/> Historial digital completo</li>
                                        <li><i class="fa fa-check"/> Vacunación incluida</li>
                                        <li><i class="fa fa-check"/> 20% dto. en laboratorio</li>
                                        <li class="disabled"><i class="fa fa-times"/> Cirugías incluidas</li>
                                    </ul>
                                    <a href="/contacto" class="vp-btn-white" style="width:100%;justify-content:center">
                                        Contratar Plan
                                    </a>
                                </div>
                            </div>

                            <!-- Plan Premium -->
                            <div class="col-lg-4 col-md-6" data-vp-animate="fade-up" data-vp-delay="300">
                                <div class="vp-plan-card">
                                    <h4>Plan Premium</h4>
                                    <p style="color:var(--vp-gray);font-size:0.88rem">Cobertura total sin límites</p>
                                    <div class="vp-plan-price"><span class="vp-price-symbol">$</span>99</div>
                                    <div class="vp-plan-period">por mes / mascota</div>
                                    <ul class="vp-plan-features">
                                        <li><i class="fa fa-check"/> Consultas ilimitadas</li>
                                        <li><i class="fa fa-check"/> Historial digital completo</li>
                                        <li><i class="fa fa-check"/> Vacunación incluida</li>
                                        <li><i class="fa fa-check"/> Laboratorio incluido</li>
                                        <li><i class="fa fa-check"/> Cirugías con descuento 50%</li>
                                    </ul>
                                    <a href="/contacto" class="vp-btn-outline" style="width:100%;justify-content:center">
                                        Contratar Plan
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="vp-services-cta">
                    <div class="container">
                        <h2>¿Tienes dudas sobre qué servicio necesita tu mascota?</h2>
                        <p>Nuestros especialistas te orientarán sin costo.</p>
                        <a href="/contacto" class="vp-btn-primary">
                            <i class="fa fa-comments me-2"/>
                            Consulta Gratuita
                        </a>
                    </div>
                </section>

                <!-- FOOTER -->
                <t t-call="veterinaria_web.footer_partial"/>

            </div>
        </t>
    </template>
</odoo>
